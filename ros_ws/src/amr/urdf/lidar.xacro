<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- laser joint-->
    <joint name="laser_joint" type="fixed" >
        <parent link="base_link" />
        <child link="laser_frame" />
        <origin xyz="0.22 0 0.035" rpy="0 0 ${pi}" />
    </joint>

    <!-- laser frame -->
    <link name="laser_frame">    <!-- set second link name -->
        <visual>
            <geometry>
                <cylinder radius="0.05" length="0.04" />     <!-- set size -->
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="red" />
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.05" length="0.04" />     <!-- set size -->
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
        </collision>
        <xacro:cylinder_inertia m="1" r="0.05" h="0.04"
                                xyz="0 0 0" rpy="0 0 0" />
    </link>

    <!-- laser reference for gazebo -->
    <gazebo reference="laser_frame">
        <material>Gazebo/Red</material>

        <sensor name="laser" type="gpu_lidar">
            <pose> 0 0 0 0 0 0 </pose>
            <visualize>false</visualize>
            <update_rate>10</update_rate>
            <lidar>
                <scan>
                    <horizontal>
                        <samples>360</samples>
                        <min_angle>-3.14</min_angle>
                        <max_angle>3.14</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.3</min>
                    <max>8</max>
                </range>
            </lidar>
                <topic>scan</topic>
                <gz_frame_id>laser_frame</gz_frame_id>
        </sensor>
    </gazebo>

</robot>