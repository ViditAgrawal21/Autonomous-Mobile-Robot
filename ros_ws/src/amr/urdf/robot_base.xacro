<?xml version="1.0"?>        <!-- to recognize the file as xml file, URDF uses metric system -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- declared variables -->
    <xacro:property name="base_length" value="0.6" />
    <xacro:property name="base_width" value="0.5" />
    <xacro:property name="base_height" value="0.03" />
    <xacro:property name="wheel_radius" value="0.05" />
    <xacro:property name="wheel_length" value="0.026" />
    <xacro:property name="caster_wheel_radius" value="${wheel_radius / 2.0}" />
    <xacro:property name="base_mass" value="5.0" />
    <xacro:property name="wheel_mass" value="1.00" />
    <xacro:property name="castor_wheel_mass" value="0.5" />

    <!-- robot links -->

    <link name="base_footprint" />

    <link name="base_link" >
        <visual>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}" />
                <!-- <mesh filename="package://amr/meshes/base_link.stl" scale="0.001 0.001 0.001" /> -->
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="blue" />
        </visual>
        <collision>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}" />     <!-- set size -->
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
        </collision>
        <xacro:box_inertia m="${base_mass}" l="${2*base_length}" w="${2*base_width}" h="${2*base_height}"
                           xyz="0 0 ${wheel_radius}" rpy="0 0 0" />
    </link>

    <link name="right_wheel_link">    <!-- set second link name -->
        <visual>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_length}" />     <!-- set size -->
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="red" />
        </visual>
        <collision>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_length}" />     <!-- set size -->
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
        </collision>
        <xacro:cylinder_inertia m="${wheel_mass}" r="${2*wheel_radius}" h="${2*wheel_length}"
                                xyz="0 0 0" rpy="0 0 0" />
    </link>

    <link name="left_wheel_link">    <!-- set second link name -->
        <visual>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_length}" />     <!-- set size -->
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="red" />
        </visual>
        <collision>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_length}" />     <!-- set size -->
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
        </collision>
        <xacro:cylinder_inertia m="${wheel_mass}" r="${2*wheel_radius}" h="${2*wheel_length}"
                                xyz="0 0 0" rpy="0 0 0" />
    </link>

    <!-- macro for defining castor wheel links -->
    <xacro:macro name="castor_wheel_link" params="prefix">
        <link name="${prefix}_castor_wheel_link">    <!-- set second link name -->
            <visual>
                <geometry>
                    <sphere radius="${caster_wheel_radius}" />     <!-- set size -->
                </geometry>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <material name="grey" />
            </visual>
            <collision>
                <geometry>
                    <sphere radius="${caster_wheel_radius}" />     <!-- set size -->
                </geometry>
                <origin xyz="0 0 0" rpy="0 0 0" />
            </collision>
            <xacro:sphere_inertia m="${castor_wheel_mass}" r="${2*caster_wheel_radius}"
                                    xyz="0 0 0" rpy="0 0 0" />
        </link>
    </xacro:macro>

    <xacro:castor_wheel_link prefix="front_right" />
    <xacro:castor_wheel_link prefix="back_right" />
    <xacro:castor_wheel_link prefix="back_left" />
    <xacro:castor_wheel_link prefix="front_left" />


    <!-- robot joints -->

    <joint name="footprint_base_jont" type="fixed">
        <parent link="base_footprint" />
        <child link="base_link" />
        <origin xyz="0 0 ${wheel_radius + 0.097}" rpy="0 0 0" />
    </joint>


    <joint name="base_right_wheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="left_wheel_link" />
        <origin xyz="0 -0.27 -0.097" rpy="${pi / 2} 0 0" />
        <axis xyz="0 0 -1" />
    </joint>

    <joint name="base_left_wheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="right_wheel_link" />
        <origin xyz="0 0.27 -0.097" rpy="${pi / 2} 0 0" />
        <axis xyz="0 0 -1" />
    </joint>

    <!-- macro for defining castor wheel joints -->
    <xacro:macro name="castor_wheel_joint" params="prefix parent child xyz rpy axis">
        <joint name="${prefix}_joint" type="fixed">
            <parent link="${parent}" />
            <child link="${child}" />
            <origin xyz="${xyz}" rpy="${rpy}" />
            <axis xyz="${axis}" />
        </joint>
    </xacro:macro>

    <xacro:castor_wheel_joint prefix="base_front_right_castor" parent="base_link" child="front_right_castor_wheel_link"
                              xyz="${base_length / 2} ${-base_width / 2} -0.122" rpy="0 0 0" axis="0 0 1" />

    <xacro:castor_wheel_joint prefix="base_back_right_castor" parent="base_link" child="front_left_castor_wheel_link"
                              xyz="${base_length / 2} ${base_width / 2} -0.122" rpy="0 0 0" axis="0 0 1" />

    <xacro:castor_wheel_joint prefix="base_back_left_castor" parent="base_link" child="back_left_castor_wheel_link"
                              xyz="${-base_length / 2} ${base_width / 2} -0.122" rpy="0 0 0" axis="0 0 1" />

    <xacro:castor_wheel_joint prefix="base_front_left_castor" parent="base_link" child="back_right_castor_wheel_link"
                              xyz="${-base_length / 2} ${-base_width / 2} -0.122" rpy="0 0 0" axis="0 0 1" />
                              
</robot>