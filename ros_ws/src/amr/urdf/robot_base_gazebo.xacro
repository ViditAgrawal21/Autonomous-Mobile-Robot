<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <gazebo reference="base_link" >          <!-- gazebo refernce in this tag is for specific to that link-->
        <material> Gazebo/Blue </material>
    </gazebo>

    <gazebo reference="right_wheel_link" >          <!-- gazebo refernce in this tag is for specific to that link-->
        <material> Gazebo/Blue </material>
    </gazebo>

    <gazebo reference="left_wheel_link" >          <!-- gazebo refernce in this tag is for specific to that link-->
        <material> Gazebo/Blue </material>
    </gazebo>

    <gazebo reference="front_right_castor_wheel_link" >          <!-- gazebo refernce in this tag is for specific to that link-->
        <material> Gazebo/Grey </material>
        <mu1 value="0.1" />
        <mu2 value="0.1" />
    </gazebo>

    <gazebo reference="back_right_castor_wheel_link" >          <!-- gazebo refernce in this tag is for specific to that link-->
        <material> Gazebo/Grey </material>
        <mu1 value="0.1" />
        <mu2 value="0.1" />
    </gazebo>

    <gazebo reference="back_left_castor_wheel_link" >          <!-- gazebo refernce in this tag is for specific to that link-->
        <material> Gazebo/Grey </material>
        <mu1 value="0.1" />
        <mu2 value="0.1" />
    </gazebo>

    <gazebo reference="front_left_castor_wheel_link" >          <!-- gazebo refernce in this tag is for specific to that link-->
        <material> Gazebo/Grey </material>
        <mu1 value="0.1" />
        <mu2 value="0.1" />
    </gazebo>

    <gazebo>
        <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">

        <!-- wheels -->
        <left_joint>base_left_wheel_joint</left_joint>
        <right_joint>base_right_wheel_joint</right_joint>

        <!-- kinematics -->
        <wheel_separation>0.54</wheel_separation>
        <wheel_radius>0.2</wheel_radius>

        <frame_id>odom</frame_id>
        <child_frame_id>base_footprint</child_frame_id>
        <odom_topic>odom</odom_topic>

        </plugin>
    </gazebo>

    <gazebo>
        <plugin
            filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
            <left_joint>base_left_wheel_joint</left_joint>
            <right_joint>base_right_wheel_joint</right_joint>
        </plugin>
    </gazebo>

</robot>