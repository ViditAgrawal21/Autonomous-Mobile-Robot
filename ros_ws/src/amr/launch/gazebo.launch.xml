<launch>

    <let name="urdf_path"
         value="$(find-pkg-share amr)/urdf/robot.xacro" />

    <let name="rviz_config"
         value="$(find-pkg-share amr)/rviz/slam_config.rviz" />

    <let name="world_file"
         value="/home/nikhil/Work/technowings/fleet-management-system/ros_ws/src/amr/worlds/basketball_arena.world" />

    <node pkg="robot_state_publisher" exec="robot_state_publisher" >
        <param name="robot_description"
               value="$(command 'xacro $(var urdf_path)')" />
    </node>

    <include file="$(find-pkg-share gazebo_ros)/launch/gazebo.launch.py">
        <arg name="world" value="$(var world_file)" />
    </include>

    <node pkg="gazebo_ros" exec="spawn_entity.py"
        args="-topic robot_description -entity amr" >
    </node>

    <node pkg="rviz2" exec="rviz2" output="screen" args="-d $(var rviz_config)"/>

    <!-- <node pkg="rviz2" exec="rviz2" output="screen" /> -->

    <!-- <include file="$(find-pkg-share amr)/launch/gazebo.launch.py" /> -->

</launch>
