<launch>
    <let name="urdf_path" 
         value="$(find-pkg-share amr)/urdf/robot.xacro" />

    <let name="rviz_config"
         value="$(find-pkg-share amr)/rviz/urdf_config.rviz" />
        
    <node pkg="robot_state_publisher" exec="robot_state_publisher">
        <param name="robot_description"
                value="$(command 'xacro $(var urdf_path)')" />
    </node>

    <node pkg="controller_manager" exec="ros2_control_node">
      <!-- Pass robot description -->
      <param name="robot_description" value="$(var urdf_path)" />
      <!-- Load controller config YAML -->
      <param name="robot_description" value="$(var urdf_path)" />
    </node>

    <node pkg="rviz2" exec="rviz2" output="screen" args="-d $(var rviz_config)"/>

    <node pkg="controller_manager" exec="spawner"
      output="screen"
      args="diff_drive_controller --controller-manager /controller_manager"/>

    <node pkg="controller_manager" exec="spawner"
      output="screen"
      args="joint_state_broadcaster --controller-manager /controller_manager"/>

</launch>
